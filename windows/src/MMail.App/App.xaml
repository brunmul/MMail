<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MMail.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Arcos clay as the accent (buttons, focus, toggles). The other Arcos colors
                 are added from Palette.cs as Arcos…Brush theme resources. -->
            <Color x:Key="SystemAccentColor">#D97757</Color>
            <Color x:Key="SystemAccentColorLight1">#E08A6A</Color>
            <Color x:Key="SystemAccentColorLight2">#E8A68C</Color>
            <Color x:Key="SystemAccentColorLight3">#F3E4DA</Color>
            <Color x:Key="SystemAccentColorDark1">#C15F3C</Color>
            <Color x:Key="SystemAccentColorDark2">#A9502F</Color>
            <Color x:Key="SystemAccentColorDark3">#8E4226</Color>
            <FontFamily x:Key="SerifFont">Georgia</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
